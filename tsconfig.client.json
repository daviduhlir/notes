{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "rootDir": "src/client",
    "outDir": "dist/client",
    "noEmitOnError": true,
    "isolatedModules": true,
    "types": ["react", "react-dom"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
